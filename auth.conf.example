# Auth Server Configuration

# Logging
# Valid levels: debug, info, warn, error
# Default: info
log_level = info
# Optional: Specify custom environment variable name for log level override
# log_level_env = MY_LOG_LEVEL

# Public identity of this server — used to build URLs (JWT `iss` claim, email links,
# TOTP issuer). localhost means http://localhost:<server_port>, reached directly; any
# other name means https://<name>, through a TLS proxy on the default port.
# This is NOT a bind address: the server always listens on all interfaces, so that
# an edge proxy or load balancer on another host can reach it. Firewall the port;
# do not rely on this setting to restrict access.
server_host = localhost
server_port = 8080
server_workers = 0

# The localhost-only admin API (bootstrap, users, organizations, org keys) has a port of
# its own, which listens on loopback alone: 127.0.0.1, and ::1 where the host has it.
# The public port refuses those endpoints. Don't publish or forward this one: run admin
# commands on the host, or with docker exec. It must differ from server_port, and each
# deployment on a host needs its own: the server refuses to start on a port in use.
admin_port = 8081

# Which request header carries the client's address, as set by the proxy in front of
# the server. It's recorded as source_ip on sessions, key-usage logs, MFA attempts and
# emailed links; nothing grants or refuses access by it. Only the header your proxy
# overwrites can be trusted: one it passes through is the client's to fill in, so
# there is no safe order to try them in.
#   x-real-ip        X-Real-IP, which the shipped nginx sets (the default)
#   x-forwarded-for  the last X-Forwarded-For entry, which the nearest proxy appended:
#                    an AWS ALB, or similar, directly in front of the server
#   none             record no address
# An unknown value refuses to start.
# client_ip_header = x-real-ip

# Database — "sqlite" or "postgresql"
db_type = sqlite

# SQLite
db_path = ./data/auth.db

# PostgreSQL (used when db_type = postgresql)
# db_host = localhost
# db_port = 5432
# db_name = auth
# db_user = auth_service
# db_password = CHANGE_ME
# Schema owner role for SET ROLE during first-run initialization
# If not set, falls back to db_user (SET ROLE becomes a no-op)
db_owner_role = auth_dbo

schema_dir = ./sql

# Enable history tables for auditing UPDATE/DELETE operations
# History tables track changes to tables with 'pin' primary keys in lookup/security schemas
# Turning this off doesn't remove history already made, nor stop its triggers writing: with
# every instance stopped, run ./auth-server --drophistory (sql/README.md).
enable_history_tables = true

# Encryption
# Passphrase used to derive keys for encrypting sensitive data at rest
# Protects usernames, emails, MFA secrets and signing keys against database compromise
# IMPORTANT: Customize this in production! Use encryption_key_env to load from environment
# Set it before the first start. The server refuses to start with a key that doesn't open
# what the database already holds. To change it, stop every instance and run
# ./auth-server --rekey, with the key in use now as encryption_key_previous and the new one
# as encryption_key; then remove encryption_key_previous (sql/README.md, --rekey).
# The passphrase is stretched with the password hashing settings below, as they are at the
# first start; the database records that, and a later change reaches it at the next --rekey.
encryption_key = customize_me
# encryption_key_env = MY_ENCRYPTION_KEY
# encryption_key_previous =
# encryption_key_previous_env = MY_PREVIOUS_ENCRYPTION_KEY

# Password hashing (argon2id or pbkdf2-sha256). Each stored hash names its method,
# so these can change: a password hashed otherwise, or at an iteration count
# outside [min, max], is hashed again with these at its next sign-in.
secret_hashing_algorithm = argon2id
secret_hash_min_iterations = 4
secret_hash_max_iterations = 4

# Machine secrets: the secrets of client, resource-server and organization keys,
# and recovery codes. They're checked on every /token, /introspect and org-key
# call, so a slow hash stalls a worker each time. Their randomness protects them:
# a generated one is 256 bits, a recovery code 80, and a supplied one must match
# machine_secret_pattern. Each setting left out takes the password one's value.
# Key secrets hashed otherwise are hashed again with these when next used; a
# recovery code set keeps the method it was made with until it's regenerated.
machine_secret_hashing_algorithm = pbkdf2-sha256
machine_secret_hash_min_iterations = 777
machine_secret_hash_max_iterations = 777

# Password policy
# Minimum password length (default 1, minimum 1)
# password_min_length = 8

# Patterns a value must match when it's created or set (POSIX extended, matched
# against the whole value). They never apply to what's already stored, so an
# existing user keeps signing in and getting links. Whatever the pattern, values
# also have length limits, no control characters, and well-formed UTF-8.
#
# Unset, usernames and code names take the shape of an email address's local
# part: letters, digits and . _ + -, with no dot first, last or doubled. Unset,
# addresses take one conservative real-world shape: that local part (at most 64
# characters), an @, and dotted labels of letters, digits and inner hyphens
# ending in an alphabetic or xn-- domain. Passwords and machine secrets have none.
# An empty value means no pattern. A pattern that lets non-ASCII through takes it
# as typed: there's no Unicode normalization or case folding, so an é typed two
# ways is two different names, and only ASCII letters match regardless of case.
# To allow, say, an apostrophe in addresses:
# email_pattern = [A-Za-z0-9_+'-]+(\.[A-Za-z0-9_+'-]+)*@[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)*\.([A-Za-z]{2,}|xn--[A-Za-z0-9-]+)
# username_pattern =
# code_name_pattern =
# password_pattern =
# A secret supplied for a client, resource-server or organization key, instead of
# one the server generates. A generated one is 256 random bits; ask as much of
# one someone chooses.
machine_secret_pattern = ^.{32,}$

# Browser session lifetime (in seconds)
# How long a login session remains valid. Clients can enforce stricter limits
# via maximum_session_seconds. Default: 604800 (7 days)
# session_ttl_seconds = 604800

# OAuth2 token limits
# Maximum TTL for client access tokens (in seconds)
# Enforced at issuance (a client's longer TTL is cut to this) and when a client
# is created or updated (a longer TTL is refused).
# Must be <= the ES256 key rotation interval (60 days) minus its 45-minute
# activation delay, or a long-lived token can outlive the key that signed it and
# fail verification before its exp. Larger values are clamped at startup.
# Default: 5097600 (59 days)
max_access_token_ttl_seconds = 5097600

# JWT clock skew tolerance (in seconds)
# Allows tokens to be accepted if expired within this tolerance window
# Default: 0 (strict validation, recommended for single-server deployments)
# Increase for distributed systems with potential clock drift
jwt_clock_skew_seconds = 0

# Database Cleaner - Background thread for purging old data
# Continuously purges expired sessions, tokens, usage logs, and history records
# to prevent unbounded database growth. It visits one table per interval and
# deletes batch_size rows at a time, and stays on a table for up to two seconds
# while its batches come back full. A table it can't clear in that time is
# logged as a warning; if that keeps happening, the table fills faster than the
# cleaner keeps up, and a larger batch size or shorter interval helps.
cleaner_enabled = true
cleaner_interval_seconds = 10
cleaner_batch_size = 1000

# SQLite only: pages freed per vacuum iteration
cleaner_sqlite_vacuum_pages = 100

# PostgreSQL only: run VACUUM after deletes (true/false)
# If false, rely entirely on PostgreSQL's autovacuum
cleaner_postgres_vacuum_enabled = true

# Retention periods (days)
retention_usage_logs_days = 60
retention_history_days = 90
retention_sessions_grace_days = 8
retention_tokens_grace_days = 8

# invitation_token_ttl_seconds = 259200

# Mothership (optional parent/brand link on index page)
# mothership_url = https://{your}.{sponsor}
# mothership_url_env = AUTH_MOTHERSHIP_URL

# Email Delivery (requires EMAIL_SUPPORT=1 build flag)
# Command to execute for sending email — receives JSON payload on stdin, exit 0 = success
# See deployment/email/ for example scripts
# email_command = ./deployment/email/send-email.sh
# (ensure the script has execute permission: chmod +x)
# email_from = noreply@example.com
# email_from_name = Auth Server
#
# email_command_env = AUTH_EMAIL_COMMAND
# email_from_env = AUTH_EMAIL_FROM
# email_from_name_env = AUTH_EMAIL_FROM_NAME
#
# email_verification_token_ttl_seconds = 86400
# password_reset_token_ttl_seconds = 3600
# passwordless_login_token_ttl_seconds = 600
